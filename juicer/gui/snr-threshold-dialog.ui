<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkDialog" id="snr_threshold_dialog">
    <property name="modal">true</property>
    <property name="default-width">420</property>
    <property name="default-height">200</property>

    <child type="titlebar">
      <object class="GtkHeaderBar">
        <property name="show-title-buttons">false</property>
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label">SNR Threshold</property>
          </object>
        </property>
        <child type="start">
          <object class="GtkButton" id="btn_cancel">
            <property name="label">Cancel</property>
            <!-- Connect in code to close the dialog without applying -->
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="btn_apply">
            <property name="label">Apply</property>
            <!-- Connect in code to read values and close -->
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>

        <!-- Row: description -->
        <child>
          <object class="GtkLabel">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="label">Choose the minimum Signal-to-Noise Ratio (SNR) required for points to be shown.</property>
          </object>
        </child>

        <!-- Row: spin + scale -->
        <child>
          <object class="GtkGrid">
            <property name="column-spacing">12</property>
            <property name="row-spacing">8</property>

            <child>
              <object class="GtkLabel">
                <property name="label">Minimum SNR</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">0</property>
              </packing>
            </child>

            <child>
              <object class="GtkSpinButton" id="spin_snr">
                <property name="halign">start</property>
                <property name="width-chars">5</property>
                <property name="digits">0</property>
                <property name="adjustment">
                  <object class="GtkAdjustment" id="adj_snr">
                    <property name="lower">0</property>
                    <property name="upper">10000</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                    <property name="value">100</property>
                  </object>
                </property>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">0</property>
              </packing>
            </child>

            <child>
              <object class="GtkScale" id="scale_snr">
                <property name="hexpand">true</property>
                <property name="adjustment">adj_snr</property>
                <property name="draw-value">true</property>
                <property name="value-pos">right</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">1</property>
                <property name="width">2</property>
              </packing>
            </child>
          </object>
        </child>

        <!-- Row: apply scope -->
        <child>
          <object class="GtkCheckButton" id="chk_apply_all">
            <property name="label">Apply to all open plots</property>
            <property name="active">true</property>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
